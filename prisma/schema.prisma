// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  // Set in .env for local development and in the Dockerfile for production.
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One row per shop. A shop with no row uses the defaults below.
model Settings {
  shop           String   @id
  enabled        Boolean  @default(true)
  percent        Float    @default(5)
  // Payment method names, one per line, exactly as they appear on orders.
  gateways       String   @default("Bank Deposit")
  label          String   @default("Bank Deposit discount")
  notifyCustomer Boolean  @default(true)
  // Card payments chosen in the pop-up before checkout get the discount too.
  cardDiscount   Boolean  @default(false)
  cardLabel      String   @default("Card payment discount")
  // Cash on delivery method names, one per line, as they appear at checkout.
  codGateways    String   @default("Cash on Delivery (COD)")
  // The automatic discount and payment customization the app created for
  // the pop-up, so they are only created once.
  discountId             String?
  paymentCustomizationId String?
  updatedAt      DateTime @updatedAt
}
