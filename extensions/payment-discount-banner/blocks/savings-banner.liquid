{%- comment -%}
  Tells shoppers how much they save by paying with the discounted payment method.
  Shopify only lets non-Plus stores add text to checkout as the payment method's
  description, so this banner sits on the cart and product pages instead.
  Settings come from the app (app/settings.server.ts publishes them).
{%- endcomment -%}
{%- assign discount = app.metafields.payment_discount.settings.value -%}
{%- comment -%} Same month as the app and the functions: the store's time zone. {%- endcomment -%}
{%- assign this_month = 'now' | date: '%Y-%m' -%}
{%- assign paused = false -%}
{%- if discount.pausedMonth == this_month -%}{%- assign paused = true -%}{%- endif -%}
{%- comment -%} Switched off in the app (missing in older settings: on). {%- endcomment -%}
{%- assign switched_off = false -%}
{%- if discount.showBanner == false -%}{%- assign switched_off = true -%}{%- endif -%}

{%- comment -%} Own wording and colours are part of the Pro and Advanced plans. {%- endcomment -%}
{%- if discount.customize -%}
  {%- assign text = block.settings.text -%}
  {%- assign card_name = block.settings.card_name -%}
  {%- assign background = block.settings.background -%}
  {%- assign text_color = block.settings.text_color -%}
{%- else -%}
  {%- assign text = 'Pay by [method] at checkout and save [percent] ([amount] off).' -%}
  {%- assign card_name = 'Credit / Debit Card' -%}
  {%- assign background = '#E8F5E9' -%}
  {%- assign text_color = '#1B5E20' -%}
{%- endif -%}

{%- if discount and discount.enabled and discount.percent > 0 and paused == false and switched_off == false -%}
  {%- if template.name == 'product' and product -%}
    {%- assign base = product.selected_or_first_available_variant.price -%}
  {%- else -%}
    {%- assign base = cart.items_subtotal_price -%}
  {%- endif -%}

  {%- comment -%}
    [method] names only what gets the discount: the bank transfer method, the
    card, or both. Settings saved before bankDiscount existed count it as on.
  {%- endcomment -%}
  {%- assign method = '' -%}
  {%- unless discount.bankDiscount == false -%}
    {%- assign method = discount.gateways | first | default: 'Bank Deposit' -%}
  {%- endunless -%}
  {%- if discount.cardDiscount and card_name != blank -%}
    {%- if method != '' -%}{%- assign method = method | append: ' or ' -%}{%- endif -%}
    {%- assign method = method | append: card_name -%}
  {%- endif -%}

  {%- if base > 0 and method != '' -%}
    {%- comment -%} Rounded down to the cent, as Shopify does for the order discount. {%- endcomment -%}
    {%- assign saving = base | times: discount.percent | divided_by: 100.0 | floor -%}
    {%- assign percent = discount.percent | append: '%' -%}
    {%- assign amount = saving | money -%}
    {%- assign message = text
      | replace: '[method]', method
      | replace: '[percent]', percent
      | replace: '[amount]', amount
    -%}
    <div
      class="payment-discount-banner"
      style="background: {{ background }}; color: {{ text_color }}; padding: 12px 16px; border-radius: 8px; margin: 12px 0; font-size: 0.95em; line-height: 1.4;"
      {{ block.shopify_attributes }}
    >
      {{ message }}
    </div>
    {%- if request.design_mode and discount.customize != true -%}
      <p style="margin: -6px 0 12px; font-size: 0.85em; opacity: 0.7;">
        Only you see this: your own wording and colours need the Pro or Advanced plan of Payment Method Discount.
      </p>
    {%- endif -%}
  {%- endif -%}
{%- elsif request.design_mode -%}
  <div style="padding: 12px 16px; border: 1px dashed #999; border-radius: 8px; margin: 12px 0;" {{ block.shopify_attributes }}>
    {%- if switched_off -%}
      Payment discount banner: switched off in the Payment Discounts app. Turn it on there to show it.
    {%- elsif paused -%}
      Payment discount banner: hidden until next month, because this month's discounted orders on your plan are used up. Upgrade in the Payment Method Discount app to show it again.
    {%- else -%}
      Payment discount banner: open the Payment Method Discount app, turn the discount on and click Save.
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Payment discount banner",
  "target": "section",
  "enabled_on": {
    "templates": ["cart", "product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Message",
      "default": "Pay by [method] at checkout and save [percent] ([amount] off).",
      "info": "[method], [percent] and [amount] are filled in from the app's settings and the cart or product price. Your own wording and colours need the Pro or Advanced plan."
    },
    {
      "type": "text",
      "id": "card_name",
      "label": "Card name in [method]",
      "default": "Credit / Debit Card",
      "info": "Used in [method] when cards get the discount in the app: on its own, or after \"Bank Deposit or\" when bank transfer does too."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#E8F5E9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1B5E20"
    }
  ]
}
{% endschema %}
