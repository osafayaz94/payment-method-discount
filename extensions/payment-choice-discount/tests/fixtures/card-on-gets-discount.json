{
  "payload": {
    "export": "cart-lines-discounts-generate-run",
    "target": "cart.lines.discounts.generate.run",
    "input": {
      "cart": {
        "choice": {
          "value": "card"
        },
        "lines": [
          {
            "id": "gid://shopify/CartLine/1"
          }
        ]
      },
      "discount": {
        "discountClasses": [
          "ORDER"
        ]
      },
      "shop": {
        "settings": {
          "jsonValue": {
            "enabled": true,
            "percent": 5,
            "gateways": [
              "Bank Deposit"
            ],
            "label": "Bank Deposit discount",
            "cardDiscount": true,
            "cardLabel": "Card payment discount",
            "codGateways": [
              "Cash on Delivery (COD)"
            ],
            "notifyCustomer": true
          }
        }
      }
    },
    "output": {
      "operations": [
        {
          "orderDiscountsAdd": {
            "candidates": [
              {
                "message": "Card payment discount",
                "targets": [
                  {
                    "orderSubtotal": {
                      "excludedCartLineIds": []
                    }
                  }
                ],
                "value": {
                  "percentage": {
                    "value": 5
                  }
                }
              }
            ],
            "selectionStrategy": "FIRST"
          }
        }
      ]
    }
  }
}