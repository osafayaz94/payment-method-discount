// Cloudflare Workers settings. The app's secrets (SHOPIFY_API_SECRET, and
// the Partner API ones for billing) are set in the Cloudflare dashboard,
// never here. See README, Deployment.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "payment-method-discount",
  "main": "./workers/app.ts",
  // Served at payment-method-discount.<account subdomain>.workers.dev.
  "workers_dev": true,
  "compatibility_date": "2026-10-01",
  // process.env holds the vars and secrets below, as the Shopify library expects.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Keep variables added in the dashboard on each deploy.
  "keep_vars": true,
  "vars": {
    "SHOPIFY_API_KEY": "e51d1ea6a855ffacddfdaa9c8550e3e4",
    "SCOPES": "read_orders,write_orders,write_order_edits,write_discounts,write_payment_customizations",
    "SHOPIFY_APP_URL": "https://payment-method-discount.osafayaz94.workers.dev"
  },
  // Sessions, settings and monthly order counts. The tables are created by
  // the app itself on first use (app/store.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "payment-method-discount",
      "database_id": "8f30715b-bd0e-42c5-b5c1-61982b05b6ce"
    }
  ]
}
